rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chatAttachments/{chatId}/{senderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == senderId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
