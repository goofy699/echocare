rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && currentUserRole() == 'admin';
    }

    function isCaregiver() {
      return signedIn() && currentUserRole() == 'caregiver';
    }

    function isDoctor() {
      return signedIn() && currentUserRole() == 'doctor';
    }

    // Users
    match /users/{userId} {
  allow read: if signedIn();

  // Public self-registration can only create patient profiles.
  // Admin-created doctor/caregiver/admin accounts should be created through Firebase Admin SDK / Cloud Functions.
  allow create: if signedIn()
                && request.auth.uid == userId
                && request.resource.data.role == "patient";

  // Users can update their own profile, but they cannot change their role,
  // assigned doctor/caregiver, suspension status, or admin-only fields.
  allow update: if isAdmin()
                || (
                  signedIn()
                  && request.auth.uid == userId
                  && request.resource.data.role == resource.data.role
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    "role",
                    "assignedDoctorId",
                    "assignedDoctorName",
                    "assignedCaregiverId",
                    "assignedCaregiverName",
                    "suspended",
                    "suspendedReason"
                  ])
                );

  allow delete: if isAdmin();
}

    // Chats
    match /chats/{chatId} {
      allow read, write: if signedIn();

      match /messages/{msgId} {
        allow read, write: if signedIn();
      }
    }

    match /chat/{chatId} {
      allow read, write: if signedIn();

      match /messages/{msgId} {
        allow read, write: if signedIn();
      }
    }

    // Doctor shifts
    match /doctorShifts/{shiftId} {
      allow create: if signedIn()
                    && request.resource.data.doctorId == request.auth.uid;

      allow read: if signedIn();

      allow update: if signedIn()
                    && (
                      resource.data.doctorId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if isAdmin();
    }

    // Caregiver shifts
    match /caregiverShifts/{shiftId} {
      allow create: if signedIn()
                    && request.resource.data.caregiverId == request.auth.uid;

      allow read: if signedIn();

      allow update: if signedIn()
                    && (
                      resource.data.caregiverId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if isAdmin();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow create: if signedIn()
                    && request.resource.data.patientId is string
                    && request.resource.data.doctorId is string
                    && request.resource.data.scheduledAt is timestamp
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                      request.resource.data.patientId == request.auth.uid ||
                      isCaregiver() ||
                      isAdmin()
                    );

      allow read: if signedIn()
                  && (
                    resource.data.patientId == request.auth.uid ||
                    resource.data.doctorId == request.auth.uid ||
                    resource.data.caregiverId == request.auth.uid ||
                    isCaregiver() ||
                    isAdmin()
                  );

      allow update, delete: if signedIn()
                            && (
                              resource.data.patientId == request.auth.uid ||
                              resource.data.doctorId == request.auth.uid ||
                              resource.data.caregiverId == request.auth.uid ||
                              isCaregiver() ||
                              isAdmin()
                            );
    }

    // Reminders
    match /reminders/{reminderId} {
      allow create: if signedIn()
                    && (
                      (
                        request.resource.data.patientId == request.auth.uid
                        && request.resource.data.createdBy == request.auth.uid
                      )
                      ||
                      (
                        isCaregiver()
                        && request.resource.data.createdBy == request.auth.uid
                        && request.resource.data.patientId is string
                      )
                      ||
                      isAdmin()
                    )
                    && request.resource.data.dueAt is timestamp
                    && request.resource.data.type is string
                    && request.resource.data.priority is string
                    && request.resource.data.status == 'pending';

      allow read: if signedIn()
                  && (
                    resource.data.patientId == request.auth.uid ||
                    resource.data.createdBy == request.auth.uid ||
                    isCaregiver() ||
                    isAdmin()
                  );

      allow update, delete: if signedIn()
                            && (
                              resource.data.patientId == request.auth.uid ||
                              resource.data.createdBy == request.auth.uid ||
                              isCaregiver() ||
                              isAdmin()
                            );
    }

    // Reports
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.doctorId is string
                    && request.resource.data.attachment is map
                    && request.resource.data.status in ['pending', 'reviewed'];

      allow read: if signedIn()
                  && (
                    resource.data.patientId == request.auth.uid ||
                    resource.data.doctorId == request.auth.uid ||
                    isAdmin()
                  );

      allow update: if signedIn()
                    && (
                      resource.data.patientId == request.auth.uid ||
                      resource.data.doctorId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if signedIn()
                    && (
                      resource.data.patientId == request.auth.uid ||
                      isAdmin()
                    );
    }

    // Notes
    match /notes/{noteId} {
      allow create: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.content is string
                    && request.resource.data.title is string;

      allow read: if signedIn()
                  && (
                    resource.data.patientId == request.auth.uid ||
                    isAdmin()
                  );

      allow update, delete: if signedIn()
                            && (
                              resource.data.patientId == request.auth.uid ||
                              isAdmin()
                            );
    }

    // SOS alerts
    match /sosAlerts/{alertId} {
      allow create: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.status in ['active', 'resolved'];

      allow read: if signedIn()
                  && (
                    resource.data.patientId == request.auth.uid ||
                    resource.data.caregiverId == request.auth.uid ||
                    resource.data.doctorId == request.auth.uid ||
                    isAdmin()
                  );

      allow update: if signedIn()
                    && (
                      resource.data.patientId == request.auth.uid ||
                      resource.data.caregiverId == request.auth.uid ||
                      resource.data.doctorId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow create: if signedIn()
                    && request.resource.data.recipientId is string
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.body is string
                    && request.resource.data.read == false;

      allow read: if signedIn()
                  && (
                    resource.data.recipientId == request.auth.uid ||
                    resource.data.senderId == request.auth.uid ||
                    isAdmin()
                  );

      allow update: if signedIn()
                    && (
                      resource.data.recipientId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}